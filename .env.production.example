# Production environment contract (Lot 2). NAMES ONLY — the real values
# live in the VPS-only .env (chmod 600), never in the repository.
#
# QUOTING (R1): per the Compose interpolation rules, "Unquoted and
# double-quoted values have interpolation applied" while "Single-quoted
# values are used literally" — so SINGLE-QUOTE any secret containing a $,
# or Compose rewrites it before it reaches the container. If a generated
# secret contains a single quote itself, regenerate it without one instead
# of escaping — simpler and parser-proof.

# GHCR image tag to deploy (both api and web are pulled at this tag).
IMAGE_TAG=

# Let's Encrypt account email (certificate expiry notices).
ACME_EMAIL=

# Database password for the smartcrops role (generated; the discrete path
# quotes it via NpgsqlConnectionStringBuilder, so any characters are safe).
POSTGRES_PASSWORD=

# JWT signing key (>= 32 chars; rotating it invalidates every session).
JWT_KEY=

# Google OAuth client (Google Cloud console, OAuth 2.0 credentials).
GOOGLE_CLIENT_ID=

# Google OAuth client secret (VPS .env only, never committed).
GOOGLE_CLIENT_SECRET=

# CSV of emails granted the Admin role at boot (optional; empty = no-op).
ADMIN_SEED_EMAILS=

# Typesense API key (also consumed by the typesense service itself).
TYPESENSE_API_KEY=

# SMTP relay password (OVH mail account used by the api's email service).
SMTP_PASSWORD=
