*.log
*.nupkg
project.lock.json
project.fragment.lock.json
artifacts/
**/Properties/launchSettings.json

# ASP.NET
appsettings.Development.json

# Entity Framework
*.db
*.db-shm
*.db-wal
# EF Core migration files must be committed — do not ignore Migrations/

# Node / React
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js
build/
dist/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.cache/
.next/

# Postman / API tooling — never commit these (may contain API tokens, env vars, secrets)
.postman/
postman/
*.postman_collection.json
*.postman_environment.json
*.postman_globals.json

# Other API tooling
.insomnia/
.bruno/

# Docker — Compose auto-merges *.override.yml/yaml; per-developer customisations
# (mount points, extra ports, local credentials) must not be committed.
docker-compose.override.yml
docker-compose.override.yaml

# OS
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Claude Code: share .claude/skills, .claude/commands, .claude/settings.json; ignore only user-local settings
.claude/settings.local.json

# coderabbit-harvest skill output files (transient, regenerable)
/tmp/harvest-*.json

# Local API response snapshots used for ad-hoc curl validation during
# enrichment work (e.g. tomato-current.json). Never commit — they're
# regenerable and tend to balloon with raw blob payloads.
*-current.json

# Bulk-import local exports (multi-MB dumps, never commit)
scripts/bulk-import/exports/